  "keyFeatures": [
    "40+ Material Design UI components",
    "Component Development Kit (CDK) for custom components",
    "Accessible headless directives with @angular/aria",
    "Comprehensive theming system with prebuilt themes",
    "Built-in accessibility and internationalization",
    "Angular CLI schematics for scaffolding",
    "Google Maps and YouTube Player integrations",
    "Multiple date adapter libraries (date-fns, Luxon, Moment)",
    "Comprehensive testing utilities and component harnesses",
    "TypeScript support with full type definitions"
  ],
  "publicApiSurface": [
    "@angular/material - MatButton, MatCard, MatDialog, MatTable, MatFormField, MatInput, MatSelect, MatCheckbox, MatRadio",
    "@angular/material - MatDatepicker, MatTimepicker, MatSlider, MatSlideToggle, MatAutocomplete, MatChips",
    "@angular/material - MatMenu, MatSidenav, MatToolbar, MatTabs, MatStepper, MatTree",
    "@angular/material - MatIcon, MatBadge, MatProgressBar, MatProgressSpinner, MatTooltip, MatSnackBar",
    "@angular/material - MatExpansion, MatGridList, MatList, MatDivider, MatPaginator, MatSort",
    "@angular/cdk/a11y - FocusTrap, LiveAnnouncer, FocusMonitor, HighContrastModeDetector",
    "@angular/cdk/overlay - Overlay, OverlayRef, OverlayConfig, ConnectedPosition",
    "@angular/cdk/drag-drop - DragDrop, CdkDragDrop, CdkDrag, CdkDropList",
    "@angular/cdk/portal - Portal, ComponentPortal, TemplatePortal, PortalOutlet",
    "@angular/cdk/scrolling - VirtualScrollViewport, ScrollDispatcher, CdkScrollable",
    "@angular/cdk/table - CdkTable, CdkRow, CdkCell, DataSource",
    "@angular/cdk/stepper - CdkStepper, CdkStep, StepperSelectionEvent",
    "@angular/cdk/dialog - Dialog, DialogRef, DialogConfig",
    "@angular/cdk/testing - ComponentHarness, TestElement, HarnessLoader",
    "@angular/aria - AccordionPanel, AccordionTrigger, Combobox, Grid, Listbox, Menu",
